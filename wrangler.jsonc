{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uttf-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "uttf-crm"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Cache ISR: le pagine rigenerate vanno su R2.
  // Creare il bucket prima del deploy: npx wrangler r2 bucket create uttf-crm-opennext-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "uttf-crm-opennext-cache"
    }
  ],
  // Tag cache su D1: dopo la creazione, applicare cloudflare/d1-next-tag-cache.sql
  // e sostituire l'id segnaposto con quello restituito da `wrangler d1 create`.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "uttf-tag-cache",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Coda delle rivalidazioni ISR: la classe è esportata dal worker OpenNext.
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}

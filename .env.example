# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by newsletter and staff review deletion APIs.
# Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional app integrations
GROQ_API_KEY=
ADMIN_PASSWORD=

# Token del feed calendario (Apple/Google Calendar). Minimo 24 caratteri.
# Se vuoto, il token viene derivato da SUPABASE_SERVICE_ROLE_KEY.
CALENDAR_FEED_TOKEN=

# Google Calendar (import eventi via OAuth).
# Creare un client OAuth di tipo "Web" su Google Cloud Console e registrare
# come redirect URI: <dominio>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chiave opzionale per cifrare i refresh token Google.
# Se vuota viene usata SUPABASE_SERVICE_ROLE_KEY.
CALENDAR_TOKEN_KEY=

# Drive locale: foto e video restano sul disco Hiksemi, su Supabase va solo l'indice.
# URL dell'agente visto dal server Next. L'agente ascolta solo su 127.0.0.1:
# il gestionale deve quindi girare sullo stesso Mac del drive.
DRIVE_AGENT_URL=http://127.0.0.1:8787
# Chiave per firmare gli URL di anteprime e originali.
# Se vuota viene usata SUPABASE_SERVICE_ROLE_KEY.
# Con l'accesso diretto deve essere lo STESSO valore impostato sull'agente.
DRIVE_MEDIA_SECRET=

# URL pubblico dell'agente dietro Cloudflare Tunnel (es. https://drive.example.com).
# Con questa variabile e DRIVE_MEDIA_SECRET, il browser carica e riproduce i file
# direttamente dal tunnel: niente limite di 4,5 MB ne' timeout delle funzioni Vercel.
# Deve puntare al tunnel, non al sito.
DRIVE_PUBLIC_URL=

# Sul Mac dell'agente servono, nel suo ambiente/LaunchAgent:
#   DRIVE_MEDIA_SECRET=<lo stesso valore qui sopra>
#   DRIVE_ALLOWED_ORIGIN=<origine del gestionale, es. https://uttf-app.vercel.app>
# Lo stesso segreto viaggia come header x-drive-token: e' quello che autorizza
# elenco file, cartelle e cancellazioni dell'agente quando la richiesta arriva
# dal tunnel. Le chiamate fatte sul Mac (127.0.0.1) non ne hanno bisogno.

# Job di conservazione dei dati (/api/maintenance/retention, cron in vercel.json).
# Il token è accettato come "Authorization: Bearer <valore>"; su Vercel basta CRON_SECRET.
RETENTION_TOKEN=
# Senza RETENTION_ENABLED=true il job è in sola lettura: conta le righe scadute e non cancella.
RETENTION_ENABLED=

# Cloudflare Tunnel + Access: il server Next presenta il service token al tunnel.
# Su Vercel vanno impostate come "Sensitive"; senza di loro ogni chiamata al
# tunnel viene respinta da Access (errore 403 dell'edge, non dell'agente).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

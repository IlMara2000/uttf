# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by newsletter and staff review deletion APIs.
# Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional app integrations
GROQ_API_KEY=
ADMIN_PASSWORD=

# Token del feed calendario (Apple/Google Calendar). Minimo 24 caratteri.
# Se vuoto, il token viene derivato da SUPABASE_SERVICE_ROLE_KEY.
CALENDAR_FEED_TOKEN=

# Google Calendar (import eventi via OAuth).
# Creare un client OAuth di tipo "Web" su Google Cloud Console e registrare
# come redirect URI: <dominio>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chiave opzionale per cifrare i refresh token Google.
# Se vuota viene usata SUPABASE_SERVICE_ROLE_KEY.
CALENDAR_TOKEN_KEY=
